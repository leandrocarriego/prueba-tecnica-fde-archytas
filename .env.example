# Plataforma Cordillera — environment variables
#
# Copy to `.env` and fill in. `.env` is NEVER committed.
# Names must match backend/app/config.py, which is the source of truth.

# ── Application ───────────────────────────────────────────
ENVIRONMENT=DEVELOPMENT
SECRET_KEY=cambiame

# ── Database (PostgreSQL) ─────────────────────────────────
# POSTGRES_PORT is the host port: docker compose publishes Postgres on it and
# the native backend connects to it. Inside containers it is always 5432.
POSTGRES_USER=cordillera
POSTGRES_PASSWORD=cordillera
POSTGRES_DB=cordillera
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ── Message broker (RabbitMQ / Celery) ────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
# Optional: derived from the RABBITMQ_* values above when left unset.
# CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=rpc://

# ── Source portal (SIGProv) ───────────────────────────────
# A third party's shared account, read-only. It lives only in the environment:
# never in the database, never in the repository, never in a log (Artículo VII).
PORTAL_BASE_URL=https://prueba-tecnica-portal.vercel.app
PORTAL_USER=proveedor
PORTAL_PASSWORD=cambiame
# false to watch the browser while debugging an extraction.
PORTAL_HEADLESS=true
# The portal's download links expire quickly: the job consumes them inside this
# window or asks for a new link.
PORTAL_DOWNLOAD_TTL_SECONDS=45
PORTAL_NAVIGATION_TIMEOUT_MS=15000

# ── Frontend ──────────────────────────────────────────────
# Solo para el frontend nativo (`npm run dev`). En contenedores la URL de la API
# la fija docker-compose.yml en `http://backend:8000`, el nombre DNS interno:
# quien la usa corre del lado servidor de Next, nunca en el navegador.
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Optional observability (profile `tools`: Flower) ──────
FLOWER_USER=admin
FLOWER_PASSWORD=admin

# ── En contenedores (`make full`, `make deploy`) ───────────
# Ignoradas cuando la app corre nativa.
#
# DOMAIN              REQUERIDA por `make deploy`: el dominio que publica
#                     Traefik. Sin ella el router queda sin regla y el sitio no
#                     responde. Su registro DNS tiene que estar en Cloudflare,
#                     porque el certificado se emite por desafio DNS.
# BIND_HOST           donde se publican los puertos. 127.0.0.1 por defecto, asi
#                     la base no queda expuesta por olvido.
# RESTART_POLICY      politica de reinicio de los contenedores.
# UVICORN_WORKERS     procesos del backend.
# CELERY_CONCURRENCY  workers de Celery por contenedor.
# DOMAIN=cordillera.example.com
# BIND_HOST=127.0.0.1
# RESTART_POLICY=unless-stopped
# UVICORN_WORKERS=2
# CELERY_CONCURRENCY=1
